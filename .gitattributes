# Normalise line endings for a cross-platform repository.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts.
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary artefacts are never normalised.
*.whl binary
*.zip binary
*.png binary
*.ico binary
