{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.git/**)",
      "Edit(./.safegit/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|MultiEdit|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/absolute/path/to/python\" -P -m safegit hook claude --policy .safegit/safegit.policy.json --approval-store /home/you/.safegit/approvals.json",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
